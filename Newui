                window:Register(check, "BackgroundColor3", "Input")
                window:Register(checkStroke, "Color", "Stroke")
                local holder = createIcon(check, "check", 9, Color3.new(1, 1, 1))
                holder.AnchorPoint = Vector2.new(0.5, 0.5)
                holder.Position = UDim2.fromScale(0.5, 0.5)
                checkImage = holder:FindFirstChildWhichIsA("ImageLabel") or holder:FindFirstChildWhichIsA("TextLabel")
                if checkImage then
                    checkImage.ImageTransparency = selected[item] and 0 or 1
                end
            end
            row.MouseEnter:Connect(function()
                tween(row, TI_Fast, {BackgroundColor3 = theme().ElementHover, BackgroundTransparency = 0.4})
            end)
            row.MouseLeave:Connect(function()
                tween(row, TI_Fast, {BackgroundColor3 = theme().Element, BackgroundTransparency = 1})
            end)
            row.Activated:Connect(function()
                if multi then
                    if selected[item] then
                        selected[item] = nil
                    else
                        selected[item] = true
                    end
                else
                    if selected[item] and allowNone then
                        selected = {}
                    else
                        selected = {[item] = true}
                    end
                end
                refresh()
                fire()
                if not multi then
                    isOpened = false
                    tween(card, TI_Fast, {Size = UDim2.new(1, 0, 0, 38)})
                end
            end)
            rows[item] = {Row = row, Label = rowLbl, Check = check, CheckImage = checkImage}
        end

        local function setOpened(state)
            isOpened = state
            if isOpened then
                tween(card, TI_Fast, {Size = UDim2.new(1, 0, 0, expandedHeight)})
                if arrowImg then
                    arrowImg.Rotation = 180
                end
            else
                tween(card, TI_Fast, {Size = UDim2.new(1, 0, 0, 38)})
                if arrowImg then
                    arrowImg.Rotation = 0
                end
            end
        end

        box.Activated:Connect(function()
            setOpened(not isOpened)
        end)
        searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            local query = string.lower(searchBox.Text)
            for item, row in pairs(rows) do
                row.Row.Visible = query == "" or string.find(string.lower(item), query, 1, true) ~= nil
            end
        end)

        refresh()
        return {
            Set = function(_, v)
                selected = {}
                if typeof(v) == "string" then
                    selected[v] = true
                elseif typeof(v) == "table" then
                    for _, item in ipairs(v) do
                        selected[item] = true
                    end
                end
                refresh()
            end,
            Get = function()
                return selectedArray()
            end,
        }
    end

