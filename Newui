end

local function prepareIconFolder()
    pcall(function()
        if isfolder and not isfolder("WindUI") then
            makefolder("WindUI")
        end
        if isfolder and not isfolder("WindUI/Icons") then
            makefolder("WindUI/Icons")
        end
    end)
end

function WindUI:GetIcon(name)
    if not name or name == "" then
        return ""
    end
    if string.sub(name, 1, 13) == "rbxassetid://" or string.sub(name, 1, 4) == "http" then
        return name
    end
    name = string.lower(name)
    if WindUI.IconCache[name] then
        return WindUI.IconCache[name]
    end
    local asset = ""
    prepareIconFolder()
    local ok = pcall(function()
        if writefile and getcustomasset and game.HttpGet then
            local data = game:HttpGet("https://api.iconify.design/lucide/" .. name .. ".png?color=%23FFFFFF&width=64&height=64")
            if data and #data > 100 then
                local path = "WindUI/Icons/" .. name .. ".png"
                writefile(path, data)
                asset = getcustomasset(path)
            end
        end
    end)
    if not ok or asset == "" then
        asset = ""
    end
    WindUI.IconCache[name] = asset
    return asset
end

local function registerIcon(window, holder, key)
    local inner = holder:FindFirstChildWhichIsA("ImageLabel") or holder:FindFirstChildWhichIsA("TextLabel")
    if inner then
        window:Register(inner, inner:IsA("ImageLabel") and "ImageColor3" or "TextColor3", key)
    end
end

local function toHexColor(c)
    return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function createIcon(parent, iconName, size, iconColor, layoutOrder)
    local holder = new("Frame", {
        Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1,
        LayoutOrder = layoutOrder or 0,
    }, parent)
    if not iconName or iconName == "" then
        return holder
    end
    local asset = WindUI:GetIcon(iconName)
    if asset == "" then
        new("TextLabel", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Text = string.upper(string.sub(iconName, 1, 1)),
            TextColor3 = iconColor or Color3.new(1, 1, 1),
            Font = Enum.Font.GothamBold,
            TextSize = math.floor(size * 0.7),
        }, holder)
    else
        new("ImageLabel", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Image = asset,
            ImageColor3 = iconColor or Color3.new(1, 1, 1),
            ScaleType = Enum.ScaleType.Fit,
        }, holder)
    end
    return holder
end

function WindUI:_register(inst, prop, key)
    table.insert(self._themeObjects, {Inst = inst, Prop = prop, Key = key})
end

function WindUI:_applyTheme()
    local theme = Themes[self.ThemeName]
    if not theme then
        return
    end
    for _, entry in ipairs(self._themeObjects) do
        if entry.Inst and entry.Inst.Parent then
            entry.Inst[entry.Prop] = theme[entry.Key]
        end
    end
end

function WindUI:_theme()
    return Themes[self.ThemeName]
end

