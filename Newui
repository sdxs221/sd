    function api:Code(cfg)
        cfg = cfg or {}
        local card = new("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = theme().CodeBlock,
            BorderSizePixel = 0,
            ZIndex = 6,
        }, getParent())
        card:SetAttribute("SearchText", cfg.Title or "Code")
        round(card, 10)
        local cardStroke = stroke(card, theme().Stroke, 1)
        window:Register(card, "BackgroundColor3", "CodeBlock")
        window:Register(cardStroke, "Color", "Stroke")
        if cfg.Title then
            local top = new("Frame", {
                Size = UDim2.new(1, 0, 0, 22),
                BackgroundTransparency = 1,
                ZIndex = 7,
            }, card)
            local dots = {"#FF5F57", "#FEBC2E", "#28C840"}
            for i, c in ipairs(dots) do
                local d = new("Frame", {
                    Size = UDim2.fromOffset(8, 8),
                    Position = UDim2.fromOffset(10 + (i - 1) * 14, 7),
                    BackgroundColor3 = Color3.fromHex(c),
                    BorderSizePixel = 0,
                    ZIndex = 7,
                }, top)
                round(d, 4)
            end
            local ttl = new("TextLabel", {
                Size = UDim2.new(1, -60, 1, 0),
                Position = UDim2.fromOffset(52, 0),
                BackgroundTransparency = 1,
                Text = cfg.Title,
                TextColor3 = theme().TextDark,
                TextSize = 10,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 7,
            }, top)
            window:Register(ttl, "TextColor3", "TextDark")
        end
        local code = new("TextLabel", {
            Size = UDim2.new(1, -20, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Position = UDim2.fromOffset(10, cfg.Title and 26 or 8),
            BackgroundTransparency = 1,
            Text = cfg.Code or "",
            TextColor3 = theme().Text,
            TextSize = 11,
            Font = Enum.Font.Code,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true,
            ZIndex = 7,
        }, card)
        window:Register(code, "TextColor3", "Text")
        new("UIPadding", {PaddingBottom = UDim.new(0, cfg.Title and 10 or 8)}, card)
        return {Set = function(_, c) code.Text = tostring(c) end, Get = function() return code.Text end}
    end

    function api:Button(cfg)
        cfg = type(cfg) == "string" and {Title = cfg, Callback = function() end} or (cfg or {})
        local card = makeCard(38)
        card:SetAttribute("SearchText", cfg.Title or "Button")
        local btn = new("TextButton", {
            Size = UDim2.new(1, -14, 0, 26),
            Position = UDim2.fromScale(0.5, 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = theme().Accent,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 7,
        }, card)
        round(btn, 13)
        local btnStroke = stroke(btn, Color3.new(1, 1, 1), 0)
        window:Register(btn, "BackgroundColor3", "Accent")
        local layout = new("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            ZIndex = 8,
        }, btn)
        local list = new("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 6),
        }, layout)
        local lbl = new("TextLabel", {
            Size = UDim2.fromOffset(0, 26),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Text = cfg.Title or "Button",
            TextColor3 = Color3.new(1, 1, 1),
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            LayoutOrder = 2,
            ZIndex = 8,
        }, layout)
        if cfg.Icon then
            createIcon(layout, cfg.Icon, 14, Color3.new(1, 1, 1), 1)
        end
        btn.MouseEnter:Connect(function()
            tween(btn, TI_Fast, {BackgroundColor3 = theme().Accent:Lerp(Color3.new(1, 1, 1), 0.12)})
        end)
        btn.MouseLeave:Connect(function()
            tween(btn, TI_Fast, {BackgroundColor3 = theme().Accent})
        end)
        btn.Activated:Connect(function()
            tween(btn, TI_Fast, {Size = UDim2.new(1, -22, 0, 22)}):Completed:Connect(function()
                tween(btn, TI_Fast, {Size = UDim2.new(1, -14, 0, 26)})
            end)
            if cfg.Callback then
                cfg.Callback()
            end
        end)
        return {Set = function(_, t) lbl.Text = tostring(t) end}
    end

    function api:Toggle(cfg)
        cfg = cfg or {}
        local state = cfg.Default or cfg.Enabled or false
        local card = makeCard(38)
        card:SetAttribute("SearchText", cfg.Title or "Toggle")
        local offsetX = 14
        if cfg.Icon then
            addCardIcon(card, cfg.Icon, 12)
            offsetX = 34
        end
        makeTitleLabel(card, cfg.Title or "Toggle", offsetX)

        local switch
        local knob
        local checkIcon
        local function applyVisual(instant)
            local info = instant and TweenInfo.new(0) or TI_Fast
            if cfg.Type == "Checkbox" then
                tween(switch, info, {BackgroundColor3 = state and theme().Accent or theme().SwitchOff})
                tween(checkIcon, info, {ImageTransparency = state and 0 or 1})
                tween(switch, info, {BackgroundTransparency = state and 0 or 0.4})
            else
                tween(switch, info, {BackgroundColor3 = state and theme().Accent or theme().SwitchOff})
                tween(knob, info, {Position = state and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)})
            end
        end

        if cfg.Type == "Checkbox" then
            switch = new("TextButton", {
                Size = UDim2.fromOffset(20, 20),
                Position = UDim2.new(1, -16, 0.5, 0),
                AnchorPoint = Vector2.new(1, 0.5),
                BackgroundColor3 = theme().SwitchOff,
                Text = "",
                AutoButtonColor = false,
                BackgroundTransparency = 0.4,
                ZIndex = 7,
            }, card)
            round(switch, 6)
            window:Register(switch, "BackgroundColor3", "SwitchOff")
            checkIcon = createIcon(switch, "check", 12, Color3.new(1, 1, 1))
            checkIcon.AnchorPoint = Vector2.new(0.5, 0.5)
            checkIcon.Position = UDim2.fromScale(0.5, 0.5)
            local ci = checkIcon:FindFirstChildWhichIsA("ImageLabel") or checkIcon:FindFirstChildWhichIsA("TextLabel")
            if ci then
                ci.ImageTransparency = state and 0 or 1
            end
        else
            switch = new("TextButton", {
                Size = UDim2.fromOffset(38, 20),
                Position = UDim2.new(1, -16, 0.5, 0),
                AnchorPoint = Vector2.new(1, 0.5),
                BackgroundColor3 = theme().SwitchOff,
                Text = "",
                AutoButtonColor = false,
                ZIndex = 7,
            }, card)
            round(switch, 10)
            window:Register(switch, "BackgroundColor3", "SwitchOff")
            knob = new("Frame", {
                Size = UDim2.fromOffset(14, 14),
                Position = UDim2.new(0, 3, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                ZIndex = 8,
            }, switch)
            round(knob, 7)
        end

        local function setState(v, fire)
            state = not not v
            applyVisual(false)
            if fire and cfg.Callback then
                cfg.Callback(state)
            end
        end
        switch.Activated:Connect(function()
            setState(not state, true)
        end)
        applyVisual(true)
        return {
            Set = function(_, v) setState(v, false) end,
            Get = function() return state end,
        }
    end

    function api:Slider(cfg)
        cfg = cfg or {}
        local valueCfg = cfg.Value or {}
        local minV = valueCfg.Min or 0
        local maxV = valueCfg.Max or 100
        local defV = valueCfg.Default or minV
        local step = cfg.Step or 1
        local suffix = cfg.Suffix or ""
        local stepStr = string.format("%f", step):gsub("0+$", "")
        local decimals = #(string.match(stepStr, "%.(%d+)") or "")
        local function fmt(v)
            return string.format("%." .. decimals .. "f", v)
        end

        local card = makeCard(46)
        card:SetAttribute("SearchText", cfg.Title or "Slider")
        local offsetX = 14
        if cfg.Icon then
            addCardIcon(card, cfg.Icon, 12)
            offsetX = 34
