            isOpened = state
            if isOpened then
                expandedHeight = 46 + gridLayout.AbsoluteContentSize.Y + 8 + (20 * 3 + 12) + 8 + 26 + 12
                tween(card, TI_Fast, {Size = UDim2.new(1, 0, 0, expandedHeight)})
            else
                tween(card, TI_Fast, {Size = UDim2.new(1, 0, 0, 38)})
            end
        end
        swatch.Activated:Connect(function()
            setOpened(not isOpened)
        end)

        return {
            Set = function(_, c) setColor(c, false) end,
            Get = function() return current end,
        }
    end

    return api
end

function WindUI:Notify(cfg)
    cfg = cfg or {}
    local window = self
    local theme = window:_theme()
    window._notifOrder = window._notifOrder + 1

    local card = new("CanvasGroup", {
        Size = UDim2.fromOffset(320, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = theme.Notification,
        BorderSizePixel = 0,
        GroupTransparency = 1,
        LayoutOrder = window._notifOrder,
        ZIndex = 110,
    }, window.NotificationHolder)
    round(card, 12)
    local cardStroke = stroke(card, theme.Stroke, 1)
    window:Register(card, "BackgroundColor3", "Notification")
    window:Register(cardStroke, "Color", "Stroke")
    new("UIPadding", {
        PaddingTop = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10),
    }, card)

    local iconBack = new("Frame", {
        Size = UDim2.fromOffset(30, 30),
        BackgroundColor3 = theme.Accent,
        BackgroundTransparency = 0.85,
        BorderSizePixel = 0,
        ZIndex = 111,
    }, card)
    round(iconBack, 8)
    window:Register(iconBack, "BackgroundColor3", "Accent")
    createIcon(iconBack, cfg.Icon or "bell", 15, theme.Accent).AnchorPoint = Vector2.new(0.5, 0.5)
    local notifIconHolder = iconBack:FindFirstChildWhichIsA("Frame")
    notifIconHolder.Position = UDim2.fromScale(0.5, 0.5)
    registerIcon(window, notifIconHolder, "Accent")

    local titleLbl = new("TextLabel", {
        Size = UDim2.new(1, -64, 0, 16),
        Position = UDim2.fromOffset(46, 2),
        BackgroundTransparency = 1,
        Text = cfg.Title or "Notification",
        TextColor3 = theme.Text,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 111,
    }, card)
    window:Register(titleLbl, "TextColor3", "Text")

    local closeNotif = new("ImageButton", {
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(1, -12, 0, 4),
        AnchorPoint = Vector2.new(1, 0),
        BackgroundTransparency = 1,
        Image = "",
        ZIndex = 112,
    }, card)
    createIcon(closeNotif, "x", 10, theme.TextDark).AnchorPoint = Vector2.new(0.5, 0.5)
    local closeNotifHolder = closeNotif:FindFirstChildWhichIsA("Frame")
    closeNotifHolder.Position = UDim2.fromScale(0.5, 0.5)
    window:Register(closeNotifHolder:FindFirstChildWhichIsA("ImageLabel") or closeNotifHolder:FindFirstChildWhichIsA("TextLabel"), "ImageColor3", "TextDark")

    local contentLbl = new("TextLabel", {
        Size = UDim2.new(1, -20, 0, 0),
        Position = UDim2.fromOffset(0, 22),
        BackgroundTransparency = 1,
        Text = cfg.Content or cfg.Desc or "",
        TextColor3 = theme.TextDark,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 111,
    }, card)
    window:Register(contentLbl, "TextColor3", "TextDark")

    local progress = new("Frame", {
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 112,
    }, card)
    window:Register(progress, "BackgroundColor3", "Accent")

    local duration = cfg.Duration or 5
    local dismissed = false
    local function dismiss()
        if dismissed then
            return
        end
        dismissed = true
        tween(card, TI_Med, {GroupTransparency = 1}):Completed:Connect(function()
            card:Destroy()
        end)
    end
    closeNotif.Activated:Connect(dismiss)
    local hit = new("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 110,
    }, card)
    hit.Activated:Connect(dismiss)

    tween(card, TI_Med, {GroupTransparency = 0})
    tween(progress, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 2)})
    task.delay(duration, dismiss)
    return {Close = dismiss}
end

function WindUI:Dialog(cfg)
    cfg = cfg or {}
    local window = self
    local theme = window:_theme()

    local overlay = new("TextButton", {
        Size = UDim2.fromScale(1, 1),
        Position = UDim2.fromScale(0, 0),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 200,
    }, window.Gui)
    local overlayStroke = nil

    local card = new("CanvasGroup", {
        Size = UDim2.fromOffset(340, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.Background,
        BorderSizePixel = 0,
        GroupTransparency = 1,
        ZIndex = 201,
    }, overlay)
    round(card, 14)
    local cardStroke = stroke(card, theme.Stroke, 1)
    window:Register(card, "BackgroundColor3", "Background")
    window:Register(cardStroke, "Color", "Stroke")
    new("UIPadding", {
        PaddingTop = UDim.new(0, 16),
        PaddingBottom = UDim.new(0, 16),
        PaddingLeft = UDim.new(0, 16),
        PaddingRight = UDim.new(0, 16),
    }, card)

    if cfg.Icon then
        local iconBack = new("Frame", {
            Size = UDim2.fromOffset(36, 36),
            BackgroundColor3 = theme.Accent,
            BackgroundTransparency = 0.85,
            BorderSizePixel = 0,
            ZIndex = 202,
        }, card)
        round(iconBack, 10)
        window:Register(iconBack, "BackgroundColor3", "Accent")
        createIcon(iconBack, cfg.Icon, 18, theme.Accent).AnchorPoint = Vector2.new(0.5, 0.5)
        local ih = iconBack:FindFirstChildWhichIsA("Frame")
        ih.Position = UDim2.fromScale(0.5, 0.5)
        window:Register(ih:FindFirstChildWhichIsA("ImageLabel") or ih:FindFirstChildWhichIsA("TextLabel"), "ImageColor3", "Accent")
    end

    local titleLbl = new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18),
        Position = UDim2.fromOffset(0, cfg.Icon and 44 or 0),
        BackgroundTransparency = 1,
        Text = cfg.Title or "Dialog",
        TextColor3 = theme.Text,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 202,
    }, card)
    window:Register(titleLbl, "TextColor3", "Text")

    local contentLbl = new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.fromOffset(0, (cfg.Icon and 44 or 0) + 22),
        BackgroundTransparency = 1,
        Text = cfg.Content or "",
        TextColor3 = theme.TextDark,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 202,
    }, card)
    window:Register(contentLbl, "TextColor3", "TextDark")

    local btnRow = new("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        Position = UDim2.new(0, 0, 0, (cfg.Icon and 44 or 0) + 26),
        BackgroundTransparency = 1,
        ZIndex = 202,
    }, card)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 8),
    }, btnRow)

    local function closeDialog()
        tween(card, TI_Fast, {GroupTransparency = 1})
        tween(overlay, TI_Fast, {BackgroundTransparency = 1}):Completed:Connect(function()
            overlay:Destroy()
        end)
    end

    local buttons = cfg.Buttons or {{Title = "OK"}}
    for i, btnCfg in ipairs(buttons) do
        local primary = btnCfg.Variant == "Primary" or (#buttons == 1)
        local b = new("TextButton", {
            Size = UDim2.fromOffset(0, 30),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundColor3 = primary and theme.Accent or theme.Element,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = i,
            ZIndex = 203,
        }, btnRow)
        round(b, 15)
        new("UIPadding", {
            PaddingLeft = UDim.new(0, 14),
            PaddingRight = UDim.new(0, 14),
        }, b)
        window:Register(b, "BackgroundColor3", primary and "Accent" or "Element")
        if not primary then
            local bst = stroke(b, theme.Stroke, 1)
            window:Register(bst, "Color", "Stroke")
        end
        local bl = new("TextLabel", {
            Size = UDim2.fromOffset(0, 30),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Text = btnCfg.Title or "Button",
            TextColor3 = primary and Color3.new(1, 1, 1) or theme.Text,
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            ZIndex = 203,
        }, b)
        if not primary then
            window:Register(bl, "TextColor3", "Text")
        end
        b.Activated:Connect(function()
            if btnCfg.Callback then
                btnCfg.Callback()
            end
            closeDialog()
        end)
    end

    local function layout()
        local contentH = math.max(contentLbl.TextBounds.Y, 16)
        btnRow.Position = UDim2.new(0, 0, 0, (cfg.Icon and 44 or 0) + 24 + contentH + 12)
    end
    contentLbl:GetPropertyChangedSignal("TextBounds"):Connect(layout)
    layout()

    tween(overlay, TI_Fast, {BackgroundTransparency = 0.45})
    tween(card, TI_Bounce, {GroupTransparency = 0})
    return {Close = closeDialog}
end

WindUI.Popup = WindUI.Dialog

function WindUI:SetTheme(name)
    if self == WindUI then
        WindUI.CurrentTheme = name
        return
    end
    if not Themes[name] then
        return
    end
    self.ThemeName = name
    self:_applyTheme()
    local theme = Themes[name]
    if self.Main then
        self.Main.BackgroundTransparency = name == "Dark" and (self.Config.Acrylic and 0.12 or 0) or 0
    end
end

function WindUI:EditOpenButton(cfg)
    cfg = cfg or {}
    local gui = self.Gui
    local openBtn = gui:FindFirstChild("OpenButton")
    if not openBtn then
        return
    end
    if cfg.Title then
        local old = openBtn:FindFirstChild("TitleLabel")
        if old then
            old:Destroy()
        end
        openBtn.Size = UDim2.fromOffset(0, 52)
        openBtn.AutomaticSize = Enum.AutomaticSize.X
        local holder = openBtn:FindFirstChildWhichIsA("Frame")
        if holder then
            holder.Position = UDim2.new(0, 16, 0.5, 0)
            holder.AnchorPoint = Vector2.new(0, 0.5)
        end
        local tl = new("TextLabel", {
            Name = "TitleLabel",
            Size = UDim2.fromOffset(0, 52),
            AutomaticSize = Enum.AutomaticSize.X,
            Position = UDim2.new(0, 48, 0, 0),
            BackgroundTransparency = 1,
            Text = "  " .. cfg.Title .. "  ",
            TextColor3 = Color3.new(1, 1, 1),
            TextSize = 13,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 51,
        }, openBtn)
    end
    if cfg.Icon then
        local holder = openBtn:FindFirstChildWhichIsA("Frame")
        if holder then
            local inner = holder:FindFirstChildWhichIsA("ImageLabel")
            local txt = holder:FindFirstChildWhichIsA("TextLabel")
            local asset = WindUI:GetIcon(cfg.Icon)
            if inner and asset ~= "" then
                inner.Image = asset
            elseif txt then
                txt.Text = string.upper(string.sub(cfg.Icon, 1, 1))
            end
        end
    end
    if cfg.Color then
        local grad = openBtn:FindFirstChildOfClass("UIGradient")
        if not grad then
            grad = new("UIGradient", {}, openBtn)
        end
        if typeof(cfg.Color) == "ColorSequence" then
            grad.Color = cfg.Color
        else
            grad.Color = ColorSequence.new(cfg.Color)
        end
    end
    if cfg.Visible ~= nil then
        self.OpenButtonEnabled = cfg.Visible
        if not self.IsOpen then
            openBtn.Visible = cfg.Visible
        end
    end
end

function WindUI:Destroy()
    if self.Gui then
        self.Gui:Destroy()
    end
    if WindUI._lastWindow == self then
        WindUI._lastWindow = nil
    end
end

function WindUI:SetTransparency(value)
    WindUI.TransparencyValue = value
end

local rawNotify = WindUI.Notify
function WindUI.Notify(self, cfg)
    if self == WindUI then
        if WindUI._lastWindow then
            return rawNotify(WindUI._lastWindow, cfg)
        end
        return
    end
    return rawNotify(self, cfg)
end

local rawDialog = WindUI.Dialog
function WindUI.Dialog(self, cfg)
    if self == WindUI then
        if WindUI._lastWindow then
            return rawDialog(WindUI._lastWindow, cfg)
        end
        return
    end
    return rawDialog(self, cfg)
end

WindUI.Popup = WindUI.Dialog

