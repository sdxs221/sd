            local arr = selectedArray()
            if #arr > 0 then
                boxLbl.Text = table.concat(arr, ", ")
                boxLbl.TextColor3 = theme().Accent
            else
                boxLbl.Text = cfg.Placeholder or "Select..."
                boxLbl.TextColor3 = theme().TextDark
            end
            for item, row in pairs(rows) do
                local isSel = selected[item] == true
                if multi then
                    tween(row.Check, TI_Fast, {BackgroundColor3 = isSel and theme().Accent or theme().Input})
                    tween(row.CheckImage, TI_Fast, {ImageTransparency = isSel and 0 or 1})
                end
                row.Label.TextColor3 = isSel and theme().Accent or theme().Text
            end
