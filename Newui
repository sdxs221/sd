function WindUI:SelectTab(index)
    local window = self
    if window.CurrentTab == index then
        return
    end
    window.CurrentTab = index
    for i, tab in ipairs(window.Tabs) do
        local selected = (i == index)
        tab.Page.Visible = selected
        if selected then
            tab.Page.Position = UDim2.fromScale(0.03, 0)
            tab.Page.CanvasPosition = Vector2.new(0, 0)
            tween(tab.Page, TI_Fast, {Position = UDim2.fromScale(0, 0)})
        end
        tween(tab.Button, TI_Fast, {BackgroundColor3 = selected and window:_theme().Accent or (tab.Hovered and window:_theme().ElementHover or window:_theme().Sidebar)})
        tween(tab.ButtonLabel, TI_Fast, {TextColor3 = selected and Color3.new(1, 1, 1) or window:_theme().TextDark})
        local iconImg = tab.IconHolder:FindFirstChildWhichIsA("ImageLabel") or tab.IconHolder:FindFirstChildWhichIsA("TextLabel")
        if iconImg then
            local targetColor = selected and (iconImg:IsA("ImageLabel") and Color3.new(1, 1, 1) or window:_theme().Accent) or window:_theme().TextDark
            if iconImg:IsA("ImageLabel") then
                tween(iconImg, TI_Fast, {ImageColor3 = targetColor})
            else
                tween(iconImg, TI_Fast, {TextColor3 = targetColor})
            end
        end
        local underline = tab.Underline
        if underline then
            underline.Visible = selected
        end
    end
end

