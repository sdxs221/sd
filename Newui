        ScrollingDirection = Enum.ScrollingDirection.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ZIndex = 5,
    }, pageHolder)
    window:Register(page, "ScrollBarImageColor3", "ScrollBar")
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
    }, page)
    new("UIPadding", {
        PaddingTop = UDim.new(0, 8),
        PaddingBottom = UDim.new(0, 16),
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12),
    }, page)

    local tab = {
        Window = window,
        Button = button,
        ButtonLabel = buttonLbl,
        IconHolder = iconHolder,
        Underline = underline,
        Page = page,
        PageHolder = pageHolder,
        SubTabs = {},
        CurrentSubTab = nil,
        Hovered = false,
    }

    button.MouseEnter:Connect(function()
        tab.Hovered = true
        if window.CurrentTab ~= index then
            tween(button, TI_Fast, {BackgroundColor3 = window:_theme().ElementHover})
        end
    end)
    button.MouseLeave:Connect(function()
        tab.Hovered = false
        if window.CurrentTab ~= index then
            tween(button, TI_Fast, {BackgroundColor3 = window:_theme().Sidebar})
        end
    end)
    button.Activated:Connect(function()
        window:SelectTab(index)
    end)

    table.insert(window.Tabs, tab)
    if index == 1 then
        window.CurrentTab = 1
    end

    local function activeContainer()
        if tab.CurrentSubTab then
            return tab.CurrentSubTab.Page
        end
        return tab.Page
    end

    local function createSubTabBar()
        if tab.SubTabBar then
            return
        end
        local bar = new("Frame", {
            Size = UDim2.new(1, -24, 0, 26),
            Position = UDim2.fromOffset(12, 8),
            BackgroundTransparency = 1,
            LayoutOrder = -999,
            ZIndex = 5,
        }, tab.Page)
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 6),
        }, bar)
        tab.SubTabBar = bar
    end

    function tab:SubTab(title)
        createSubTabBar()
        local subIndex = #tab.SubTabs + 1
        local subTheme = window:_theme()

        local pill = new("TextButton", {
            Size = UDim2.fromOffset(0, 26),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundColor3 = subTheme.Element,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = subIndex,
            ZIndex = 6,
        }, tab.SubTabBar)
        round(pill, 13)
        new("UIPadding", {
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
        }, pill)
        local pillLbl = new("TextLabel", {
            Size = UDim2.fromOffset(0, 26),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Text = title or ("Sub " .. subIndex),
            TextColor3 = subTheme.TextDark,
            TextSize = 11,
            Font = Enum.Font.GothamBold,
            ZIndex = 6,
        }, pill)

        local subPage = new("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, -40),
            Position = UDim2.fromOffset(0, 40),
            BackgroundColor3 = subTheme.Background,
            BackgroundTransparency = 0,
            BorderSizePixel = 0,
            Visible = false,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = subTheme.ScrollBar,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 5,
        }, pageHolder)
        window:Register(subPage, "BackgroundColor3", "Background")
        window:Register(subPage, "ScrollBarImageColor3", "ScrollBar")
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 6),
        }, subPage)
        new("UIPadding", {
            PaddingTop = UDim.new(0, 0),
            PaddingBottom = UDim.new(0, 16),
            PaddingLeft = UDim.new(0, 0),
            PaddingRight = UDim.new(0, 4),
        }, subPage)

        local sub = {
            Page = subPage,
            Pill = pill,
            PillLabel = pillLbl,
            Title = title,
        }

        local function selectSub()
            if tab.CurrentSubTab == sub then
                return
            end
            tab.CurrentSubTab = sub
            for _, other in ipairs(tab.SubTabs) do
                local isSelf = other == sub
                other.Page.Visible = isSelf
                tween(other.Pill, TI_Fast, {BackgroundColor3 = isSelf and window:_theme().Accent or window:_theme().Element})
                tween(other.PillLabel, TI_Fast, {TextColor3 = isSelf and Color3.new(1, 1, 1) or window:_theme().TextDark})
            end
            subPage.CanvasPosition = Vector2.new(0, 0)
        end

        pill.Activated:Connect(selectSub)
        table.insert(tab.SubTabs, sub)
        selectSub()

        local subApi = buildElementAPI(window, function()
            return subPage
        end)
        subApi._sub = sub
        return subApi
    end

    local elementApi = buildElementAPI(window, activeContainer)
    for k, v in pairs(elementApi) do
        tab[k] = v
    end
    return tab
end

function buildElementAPI(window, getParent)
    local api = {}

    local function theme()
        return window:_theme()
    end

    local orderCounter = 0
    local function nextOrder()
        orderCounter = orderCounter + 1
        return orderCounter
    end

    local function makeCard(height, order)
        local card = new("Frame", {
            Size = UDim2.new(1, 0, 0, height or 40),
            BackgroundColor3 = theme().Element,
            BorderSizePixel = 0,
            LayoutOrder = order or nextOrder(),
            ZIndex = 6,
        }, getParent())
        round(card, 10)
        local cardStroke = stroke(card, theme().Stroke, 1)
        window:Register(card, "BackgroundColor3", "Element")
        window:Register(cardStroke, "Color", "Stroke")
        card.MouseEnter:Connect(function()
            tween(card, TI_Fast, {BackgroundColor3 = theme().ElementHover})
        end)
        card.MouseLeave:Connect(function()
            tween(card, TI_Fast, {BackgroundColor3 = theme().Element})
        end)
        return card
    end

    local function makeTitleLabel(card, text, offsetX)
        local lbl = new("TextLabel", {
            Size = UDim2.new(0.55, 0, 1, 0),
            Position = UDim2.fromOffset(offsetX or 14, 0),
            BackgroundTransparency = 1,
            Text = text or "",
            TextColor3 = theme().Text,
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 7,
        }, card)
        window:Register(lbl, "TextColor3", "Text")
        return lbl
    end

    local function addCardIcon(card, iconName, offsetX, colorKey)
        local holder = createIcon(card, iconName, 15, theme()[colorKey or "TextDark"])
        holder.Position = UDim2.new(0, offsetX, 0.5, 0)
        holder.AnchorPoint = Vector2.new(0, 0.5)
        local inner = holder:FindFirstChildWhichIsA("ImageLabel") or holder:FindFirstChildWhichIsA("TextLabel")
        if inner then
            window:Register(inner, inner:IsA("ImageLabel") and "ImageColor3" or "TextColor3", colorKey or "TextDark")
        end
        return holder
    end

    function api:Section(cfg)
        cfg = type(cfg) == "string" and {Title = cfg} or (cfg or {})
        local holder = new("Frame", {
            Size = UDim2.new(1, 0, 0, 22),
            BackgroundTransparency = 1,
            LayoutOrder = 0,
            ZIndex = 6,
        }, getParent())
        local bar = new("Frame", {
            Size = UDim2.fromOffset(3, 12),
            Position = UDim2.fromOffset(2, 5),
            BackgroundColor3 = theme().Accent,
            BorderSizePixel = 0,
            ZIndex = 6,
        }, holder)
        round(bar, 2)
        window:Register(bar, "BackgroundColor3", "Accent")
        local lbl = new("TextLabel", {
            Size = UDim2.new(1, -12, 1, 0),
            Position = UDim2.fromOffset(12, 0),
            BackgroundTransparency = 1,
            Text = string.upper(cfg.Title or "Section"),
            TextColor3 = theme().TextDark,
            TextSize = 11,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 6,
        }, holder)
        window:Register(lbl, "TextColor3", "TextDark")
        return holder
    end

    function api:Divider()
        local line = new("Frame", {
            Size = UDim2.new(1, 0, 0, 1),
            BackgroundColor3 = theme().Stroke,
            BorderSizePixel = 0,
            ZIndex = 6,
        }, getParent())
        window:Register(line, "BackgroundColor3", "Stroke")
        return line
    end

    function api:Space(cfg)
        cfg = cfg or {}
        local spacer = new("Frame", {
            Size = UDim2.new(1, 0, 0, cfg.Index or 8),
