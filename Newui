            Text = cfg.Title or "Slider",
            TextColor3 = theme().Text,
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 7,
        }, card)
        window:Register(titleLbl, "TextColor3", "Text")
        local valLbl = new("TextLabel", {
            Size = UDim2.new(0.5, -offsetX, 0, 18),
            Position = UDim2.new(1, -14, 0, 6),
            AnchorPoint = Vector2.new(1, 0),
            BackgroundTransparency = 1,
            Text = fmt(defV) .. suffix,
            TextColor3 = theme().Accent,
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Right,
            ZIndex = 7,
        }, card)
        window:Register(valLbl, "TextColor3", "Accent")

        local track = new("Frame", {
            Size = UDim2.new(1, -(offsetX + 14), 0, 5),
            Position = UDim2.new(0, offsetX, 0, 33),
            BackgroundColor3 = theme().Track,
            BorderSizePixel = 0,
            ZIndex = 7,
        }, card)
        round(track, 3)
        window:Register(track, "BackgroundColor3", "Track")
        local fill = new("Frame", {
            Size = UDim2.fromScale(math.clamp((defV - minV) / (maxV - minV), 0, 1), 1),
            BackgroundColor3 = theme().Accent,
            BorderSizePixel = 0,
            ZIndex = 7,
        }, track)
        round(fill, 3)
        window:Register(fill, "BackgroundColor3", "Accent")
        local knob = new("Frame", {
            Size = UDim2.fromOffset(13, 13),
            Position = UDim2.fromScale(math.clamp((defV - minV) / (maxV - minV), 0, 1), 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            ZIndex = 8,
        }, track)
        round(knob, 7)
        local knobStroke = stroke(knob, theme().Accent, 2)
        window:Register(knobStroke, "Color", "Accent")

        local bubble = new("TextLabel", {
            Size = UDim2.fromOffset(40, 18),
            Position = UDim2.new(0.5, 0, 0, -11),
            AnchorPoint = Vector2.new(0.5, 1),
            BackgroundColor3 = theme().Text,
            Text = fmt(defV) .. suffix,
            TextColor3 = theme().Background,
            TextSize = 10,
            Font = Enum.Font.GothamBold,
            ZIndex = 9,
            Visible = false,
        }, knob)
        round(bubble, 9)
        window:Register(bubble, "BackgroundColor3", "Text")
        window:Register(bubble, "TextColor3", "Background")

        local current = defV
        local sliding = false

        local function setValue(v, fire)
            v = math.clamp(tonumber(fmt(math.clamp(v, minV, maxV))) or minV, minV, maxV)
            current = v
            local percent = (v - minV) / (maxV - minV)
            fill.Size = UDim2.fromScale(percent, 1)
            knob.Position = UDim2.fromScale(percent, 0.5)
            valLbl.Text = fmt(v) .. suffix
            bubble.Text = fmt(v) .. suffix
            if fire and cfg.Callback then
                cfg.Callback(v)
            end
        end

        local function updateFromInput(input)
            local rel = input.Position.X - track.AbsolutePosition.X
            local percent = math.clamp(rel / track.AbsoluteSize.X, 0, 1)
            local raw = minV + (maxV - minV) * percent
            local snapped = minV + math.floor((raw - minV) / step + 0.5) * step
            setValue(snapped, true)
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                bubble.Visible = true
                valLbl.Visible = false
                updateFromInput(input)
            end
        end)
        knob.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                bubble.Visible = true
                valLbl.Visible = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateFromInput(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if sliding then
                    sliding = false
                    valLbl.Visible = true
                    task.delay(0.1, function()
                        bubble.Visible = false
                    end)
                end
            end
        end)

        setValue(defV, false)
        return {
            Set = function(_, v) setValue(v, false) end,
            Get = function() return current end,
        }
    end

