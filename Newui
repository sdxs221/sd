            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = theme().Element,
            BorderSizePixel = 0,
            ZIndex = 6,
        }, getParent())
        card:SetAttribute("SearchText", cfg.Title or "Paragraph")
        round(card, 10)
        local cardStroke = stroke(card, theme().Stroke, 1)
        window:Register(card, "BackgroundColor3", "Element")
        window:Register(cardStroke, "Color", "Stroke")
        local pad = new("UIPadding", {
            PaddingTop = UDim.new(0, 8),
            PaddingBottom = UDim.new(0, 8),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
        }, card)
        local title = new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Text = cfg.Title or "",
            TextColor3 = theme().Text,
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            ZIndex = 7,
        }, card)
